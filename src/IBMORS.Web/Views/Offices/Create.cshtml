@model IBMORS.Web.Models.Office

@{
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";
    ViewData["Title"] = "Add Office";
}

<div class="mb-4">
    <h3 class="fw-bold text-primary">Add Office</h3>
    <p class="text-muted">Create a new office or office section.</p>
</div>

<div class="card shadow-sm border-0">
    <div class="card-body">

        <form method="post" asp-controller="Offices" asp-action="Create">

            <div class="mb-3">
                <label asp-for="OfficeCode" class="form-label"></label>
                <input asp-for="OfficeCode" class="form-control" />
                <span asp-validation-for="OfficeCode" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="OfficeName" class="form-label"></label>
                <input asp-for="OfficeName" class="form-control" />
                <span asp-validation-for="OfficeName" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="OfficeType" class="form-label"></label>
                <select asp-for="OfficeType" class="form-select">
                    <option value="Office">Office</option>
                    <option value="Section">Section</option>
                    <option value="Unit">Unit</option>
                </select>
            </div>

            <div class="mb-3">
                <label asp-for="Status" class="form-label"></label>
                <select asp-for="Status" class="form-select">
                    <option value="Active">Active</option>
                    <option value="Inactive">Inactive</option>
                </select>
            </div>

            <button type="submit" class="btn btn-primary">
                Save Office
            </button>

            <a asp-action="Index" class="btn btn-secondary">
                Cancel
            </a>

        </form>

    </div>
</div>