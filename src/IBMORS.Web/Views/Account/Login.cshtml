@{
       Layout = null;
}

<!DOCTYPE html>
<html lang="en">

<head>
       <meta charset="utf-8" />
       <meta name="viewport" content="width=device-width, initial-scale=1.0" />

       <title>eBudget Login</title>

       <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css">
</head>

<body class="bg-light">

       <div class="container">

              <div class="row justify-content-center align-items-center" style="min-height:100vh;">

                     <div class="col-md-6">

                            <div class="card shadow border-0 rounded-4 overflow-hidden">

                                   <!-- Header -->
                                   <div class="card-header text-center text-white py-5"
                                        style="background-color:#0B5ED7;">

                                          <img src="~/images/pgg-logo.png" alt="PGG Logo"
                                               style="width:85px;height:85px;" class="mb-3" />

                                          <h2 class="fw-bold mb-2">
                                                 eBudget
                                          </h2>

                                          <p class="mb-3 small">
                                                 Electronic Budget Monitoring,<br />
                                                 Obligation and Reporting System
                                          </p>

                                          <div class="border-top border-light w-75 mx-auto mb-3"></div>

                                          <small class="fw-semibold">
                                                 Provincial Government of Guimaras
                                          </small>

                                   </div>

                                   <!-- Body -->
                                   <div class="card-body p-5">

                                          <form method="post" asp-controller="Account" asp-action="Login">

                                                 <div class="mb-4">

                                                        <label class="form-label fw-semibold">
                                                               Username
                                                        </label>

                                                        <input type="text" class="form-control form-control-lg"
                                                               placeholder="Enter username">

                                                 </div>

                                                 <div class="mb-4">

                                                        <label class="form-label fw-semibold">
                                                               Password
                                                        </label>

                                                        <input type="password" class="form-control form-control-lg"
                                                               placeholder="Enter password">

                                                 </div>

                                                 <div class="form-check mb-4">

                                                        <input class="form-check-input" type="checkbox" id="rememberMe">

                                                        <label class="form-check-label" for="rememberMe">

                                                               Remember Me

                                                        </label>

                                                 </div>

                                                 <button type="submit" class="btn btn-primary btn-lg w-100">

                                                        Sign In

                                                 </button>

                                          </form>

                                   </div>

                                   <!-- Footer -->
                                   <div class="card-footer bg-white text-center py-3">

                                          <small class="text-muted">
                                                 eBudget Version 1.0
                                          </small>

                                   </div>

                            </div>

                     </div>

              </div>

       </div>

</body>

</html>